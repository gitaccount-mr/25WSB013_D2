#include <SPI.h>
#include <RF24.h>

RF24 radio(8, 7);
const byte address[6] = "00001";

char text[33];

void setup() {
  Serial.begin(9600);

  if (!radio.begin()) {
    Serial.println("Radio not responding!");
    while (1);
  }

  radio.enableDynamicPayloads();
  radio.setPALevel(RF24_PA_LOW);
  radio.setDataRate(RF24_1MBPS);
  radio.setChannel(76);

  radio.openReadingPipe(0, address);
  radio.startListening();
}

void loop() {
  if (radio.available()) {

    uint8_t len = radio.getDynamicPayloadSize();

    // Ignore invalid payloads
    if (len == 0 || len > 32) {
      radio.flush_rx();
      return;
    }

    radio.read(&text, len);
    text[len] = '\0';

    // Ignore empty strings
    if (strlen(text) == 0) {
      return;
    }

    Serial.println(text); // ONLY prints real messages
  }
}
